    <comp lib="3" loc="(60,20)" name="Text"><a name="text" val="UKLAD PO ROZWINIECIU SHANNONA  f = b'(c'*f00 + c*f01) + b*(c'*f10 + c*f11)   ;   f00 = a*d,  f01 = a'*d,  f10 = a' + d',  f11 = 1"/></comp>
